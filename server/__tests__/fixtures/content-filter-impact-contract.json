  "validation_cases": [
    {
      "name": "reject_python_inline_dotall",
      "rule": {"dimension": "actor", "mode": "regex_exclude", "value": "(?s).", "enabled": true},
      "expected": {
        "status": 422,
        "body": {
          "detail": {
            "error": {
              "code": "content_filter.invalid_value",
              "message": "regex patterns for impact comparison must contain only literal branches separated by '|'"
            }
          }
        }
      }
    },
    {
      "name": "reject_invalid_mode",
      "rule": {"dimension": "actor", "mode": "before", "value": "Alice", "enabled": true},
      "expected": {
        "status": 422,
        "body": {
          "detail": {
            "error": {
              "code": "content_filter.invalid_mode",
              "message": "actor rules do not support mode 'before'"
            }
          }
        }
      }
    },
    {
      "name": "reject_unicode_age_digits",
      "rule": {"dimension": "age", "mode": "min_age", "value": "١٨", "enabled": true},
      "expected": {
        "status": 422,
        "body": {"detail": {"error": {
          "code": "content_filter.invalid_value",
          "message": "age rules require an integer from 0 to 150 using ASCII digits [0-9]"
        }}}
      }
    },
