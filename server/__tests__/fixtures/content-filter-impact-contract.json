      "name": "reject_age_above_portable_domain",
      "rule": {"dimension": "age", "mode": "min_age", "value": "151", "enabled": true},
      "expected": {
        "status": 422,
        "body": {"detail": {"error": {
          "code": "content_filter.invalid_value",
          "message": "age rules require an integer from 0 to 150 using ASCII digits [0-9]"
        }}}
      }
    },
    {
      "name": "reject_regex_over_200_unicode_code_points",
      "rule": {"dimension": "actor", "mode": "regex_exclude", "value": "__REPEATED_VALUE__", "enabled": true},
