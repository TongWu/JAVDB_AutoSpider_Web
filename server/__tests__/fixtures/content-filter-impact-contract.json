      "expected": {
        "status": 422,
        "body": {"detail": {"error": {
          "code": "content_filter.invalid_value",
          "message": "regex pattern too long (max 200 Unicode code points)"
        }}}
      }
    },
    {
      "name": "reject_regex_metacharacters_before_backend_redos_messages",
